{
    "name": "@lonewolfyx/setup",
    "type": "module",
    "version": "0.0.12",
    "packageManager": "pnpm@10.33.2",
    "description": "Instant project boilerplate setup",
    "author": "lonewolfyx <olddrivero.king@qq.com>",
    "license": "MIT",
    "homepage": "https://github.com/lonewolfyx/setup",
    "bugs": {
        "url": "https://github.com/lonewolfyx/setup/issues"
    },
    "keywords": [],
    "exports": {
        ".": "./dist/cli.mjs",
        "./package.json": "./package.json"
    },
    "types": "./dist/cli.d.mts",
    "bin": {
        "setup": "./bin/cli.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "prepublishOnly": "pnpm build",
        "prepare": "simple-git-hooks"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "dependencies": {
        "@clack/prompts": "^1.0.0",
        "citty": "^0.2.2",
        "defu": "^6.1.7",
        "find-up": "^8.0.0",
        "glob": "^13.0.6",
        "jiti": "^2.6.1",
        "pkg-types": "^2.3.1",
        "tinyexec": "^1.1.2"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^8.2.0",
        "@lonewolfyx/tsconfig": "^0.0.6",
        "@types/node": "^25.6.0",
        "eslint": "^10.3.0",
        "nano-staged": "^1.0.2",
        "picocolors": "^1.1.1",
        "simple-git-hooks": "^2.13.1",
        "tsdown": "^0.21.10",
        "tsdown-preset": "^1.0.6",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3"
    },
    "simple-git-hooks": {
        "pre-commit": "npx nano-staged",
        "commit-msg": "node scripts/verify-commit.js"
    },
    "nano-staged": {
        "*": "eslint --fix"
    }
}
